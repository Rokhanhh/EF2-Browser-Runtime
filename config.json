{
  "remoteBase": "https://game.endlessfrontier.io",
  "listenPort": 8080,
  "bundleInfoUrlTemplate": "https://slime-checkinfo.s3.us-east-1.amazonaws.com/ef2_{bundle_mode}/bundle.json",
  "proxyPrefix": "/__ef_proxy__",
  "wsProxyPrefix": "/__ef_ws_proxy__",
  "appBasePath": "/endlessfrontier2",
  "bundleStaticPrefixes": {
    "assets": "assets/",
    "icons": "icons/",
    "transcoders": "transcoders/"
  },
  "bundleStaticFiles": {
    "gameManifest": "game-manifest.json",
    "manifest": "manifest.json",
    "serviceWorker": "sw.js",
    "favicon": "favicon.ico"
  },
  "logging": {
    "showRequestLogs": true,
    "showAssetRequestLogs": false,
    "showHeartbeatLogs": true,
    "heartbeatIntervalSeconds": 60
  }
}
