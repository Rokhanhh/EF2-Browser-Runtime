{
	"appId": "com.ekkorr.ef2.gb",
	"appName": "Endless Frontier 2",
	"webDir": "dist",
	"ios": {
		"path": "iosG",
		"contentInset": "never",
		"preferredContentMode": "mobile"
	},
	"android": {
		"path": "androidG",
		"allowMixedContent": true
	},
	"server": {
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"StatusBar": {
			"style": "DARK",
			"overlaysWebView": true
		},
		"ScreenOrientation": {
			"orientation": "portrait"
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 2000,
			"backgroundColor": "#000000"
		},
		"KeepAwake": {
			"enabled": true
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com",
				"apple.com"
			]
		},
		"ZipPlugin": {}
	}
}
